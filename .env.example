# PropRelay - Local Phase 2 Environment Configuration
# Copy this file to .env for local overrides (never commit .env to version control)

# Local LiveKit Server Endpoint & Credentials (dev mode defaults)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Application & Token Settings
AGENT_NAME=proprelay-agent
TOKEN_TTL_SECONDS=3600

# File Storage Paths (relative to repository root or absolute)
EVENT_JOURNAL_PATH=data/events.jsonl
PROPERTIES_DATA_PATH=data/listings.json
SHOWINGS_DATA_PATH=data/showings.json

# Logging Configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
